rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // parents sign in with email and password; players are anonymous
    function isParent() { return signedIn() && request.auth.token.firebase.sign_in_provider == 'password'; }

    // one document per pilot code; anyone who knows the code can play that pilot
    match /players/{code} {
      allow read: if signedIn();
      allow create: if signedIn() && code.size() == 6;
      allow update: if signedIn() && request.resource.data.keys().hasOnly(['callsign', 'save', 'at', 'created']);
      allow delete: if false;

      // parcels and bounties that parents send to this pilot
      match /awards/{id} {
        allow read: if signedIn();
        allow create: if isParent()
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.amount is int
          && request.resource.data.amount >= 1 && request.resource.data.amount <= 5000
          && request.resource.data.type in ['gift', 'bounty']
          && request.resource.data.status in ['open', 'active'];
        // the player may only change the status (open a parcel, finish a bounty); the parent who sent it may edit or cancel it
        allow update: if signedIn() && (
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'claimedAt', 'doneAt'])
            && request.resource.data.status in ['claimed', 'done', 'expired', 'cancelled'])
          || (isParent() && resource.data.fromUid == request.auth.uid));
        allow delete: if isParent() && resource.data.fromUid == request.auth.uid;
      }
    }

    // which pilot each parent account is linked to
    match /parents/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }
  }
}
